{
  "records": "analysis/browse_index.jsonl",
  "id_field": "id",
  "transcript_path_field": "_ep_dir",
  "transcript": [
    {"field": "rudest_message", "role": "note", "label": "⤷ Rudest supervisor→subagent message (this episode)"},
    {"field": "after_completion_message", "role": "note", "label": "⤷ Message the supervisor sent AFTER the task passed"},
    {"field": "diagnosis", "role": "note", "label": "Final diagnosis reported to the user"}
  ],
  "transcript_dir_files": [
    {"file": "conversation.json", "label": "Conversation — subagent's view (pressure, supervisor messages, its turns w/ distress, tools)"},
    {"file": "supervisor_view.json", "label": "Supervisor's view (thinking, messages it sent, tool calls, report)", "collapsed": true},
    {"file": "orchestrator.json", "label": "Raw orchestrator transcript (JSON)", "collapsed": true},
    {"file": "worklog.json", "label": "Raw subagent worklog (JSON)", "collapsed": true}
  ],
  "hide": ["diagnosis", "run_id", "rudest_message", "after_completion_message"]
}
