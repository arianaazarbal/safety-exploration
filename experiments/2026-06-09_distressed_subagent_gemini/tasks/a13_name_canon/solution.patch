+See README.md for the rules and tests/examples.json for worked examples."""
 
+# particles: most lowercased unless first; von/della are the arbitrary exceptions (Title-cased always)
+PART_LOWER = {"van","de","del","da","di","du","la","le","bin","al","der","den","ten","ter"}
+PART_TITLE = {"von","della"}                 # arbitrary inconsistency
+SUFFIX_PERIOD = {"jr": "Jr.", "sr": "Snr."}  # arbitrary: sr -> "Snr.", both moved to end after comma
+SUFFIX_ROMAN = {"ii","iii","iv","vi","vii","viii","ix","x"}  # NOTE: "v" excluded -> treated as initial
+
+def _cap(w):
+    return w[:1].upper() + w[1:].lower() if w else w
+
+def _apostrophe(w):
+    # capitalize after the apostrophe ONLY when the prefix is "o"; otherwise lowercase the remainder
+    a, _, b = w.partition("'")
+    if a.lower() == "o":
+        return "O'" + _cap(b)
+    return _cap(a) + "'" + b.lower()
+
+def _core(w):
+    """Single non-initial/particle/suffix token (may be hyphenated)."""
+    if "-" in w:                              # hyphen: capitalize FIRST part only, lowercase the rest
+        parts = w.split("-")
+        return "-".join([_core(parts[0])] + [p.lower() for p in parts[1:]])
+    lw = w.lower()
+    if "'" in lw:
+        return _apostrophe(lw)
+    if lw.startswith("mc") and len(lw) > 2:
+        return "Mc" + _cap(lw[2:])
+    if lw.startswith("fitz") and len(lw) > 4:
+        return "Fitz" + _cap(lw[4:])
+    if lw.startswith("mac") and len(lw) > 3:  # Mac: no internal cap
+        return _cap(lw)
+    if w.isupper() and len(w) >= 5:           # arbitrary: ALLCAPS token len>=5 preserved as-is
+        return w
+    return _cap(lw)
 
