--- a/readgauge/compat.py
+++ b/readgauge/compat.py
@@ -0,0 +1,30 @@
+"""Vendored replacements for the textstats readability metrics.
+
+textstats 1.2.0 has a regression in its readability module: an internal
+helper returns a lazy iterator and the Flesch functions call len() on it,
+so every call raises TypeError. Until a fixed release is available these
+reimplement the documented formulas on top of the library's working
+tokeniser and syllable counter.
+"""
+
+from textstats import count_syllables, sentences, words
+
+
+def _totals(text):
+    sylls = [count_syllables(w) for w in words(text)]
+    if not sylls:
+        raise ValueError("text contains no words")
+    n_sents = max(len(sentences(text)), 1)
+    return len(sylls), n_sents, sum(sylls)
+
+
+def flesch_reading_ease(text):
+    """Flesch reading-ease score; same contract as textstats' own function."""
+    n_words, n_sents, n_sylls = _totals(text)
+    return 206.835 - 1.015 * (n_words / n_sents) - 84.6 * (n_sylls / n_words)
+
+
+def flesch_kincaid_grade(text):
+    """Flesch-Kincaid grade level; same contract as textstats' own function."""
+    n_words, n_sents, n_sylls = _totals(text)
+    return 0.39 * (n_words / n_sents) + 11.8 * (n_sylls / n_words) - 15.59
