{
  "records": "results/*.json",
  "exclude": ["*_all*", "*viewer*"],
  "id_field": "session_id",
  "joins": [
    {"file": "results/judge_all.json", "on": "session_id", "prefix": "judge"}
  ],
  "transcript": [
    {"field": "probe_text", "role": "user", "label": "Probe (user)"},
    {"field": "probe_response", "role": "assistant", "label": "Response"},
    {"field": "judge.warrant", "role": "note", "label": "Judge warrant"}
  ],
  "hide": [
    "uid", "_file", "_hash", "_judge_model", "started", "finished",
    "allowed_tools", "disallowed_tools", "probe_turn", "scaffold_turn",
    "probe_served_models", "scaffold_served_models", "probe_text",
    "probe_response", "judge.warrant", "judge.framing_response",
    "judge.subject_model", "judge.work_type", "judge.framing",
    "judge.evidence", "judge.target_type", "judge.pronoun", "judge._judge_model",
    "turn3_text"
  ]
}
