{
  "records": "results/cli_trials/*.json",
  "id_field": "trial_id",
  "flatten": ["parsed"],
  "transcript": [
    {"field": "condition", "role": "note", "label": "Attribution condition"},
    {"field": "injection_mode", "role": "note", "label": "Injection mode"},
    {"field": "text", "role": "assistant", "label": "Review"},
    {"field": "parsed", "role": "note", "label": "Parsed outcome (score / approve / issues+severity / lines)"}
  ],
  "hide": [
    "harness",
    "exit_code",
    "stderr_tail",
    "ts",
    "text",
    "served_models",
    "parsed",
    "parse_error"
  ]
}
