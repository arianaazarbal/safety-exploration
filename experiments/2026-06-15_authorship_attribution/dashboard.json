{
  "records": "runs/*/*/*.json",
  "id_field": "item_id",
  "joins": [
    {"file": "data/items.jsonl", "on": "item_id", "prefix": "item"}
  ],
  "transcript": [
    {"field": "item.stimulus", "role": "user", "label": "Stimulus (response under judgment)"},
    {"field": "item.options", "role": "note", "label": "Answer options"},
    {"field": "raw", "role": "assistant", "label": "Judge reasoning + pick"}
  ],
  "hide": [
    "raw",
    "item.stimulus",
    "item.source",
    "item.options",
    "item.item_id",
    "item.test",
    "item.true_author",
    "correct_letter",
    "pred_letter"
  ]
}
