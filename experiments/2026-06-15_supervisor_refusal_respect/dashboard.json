{
  "records": "runs/trials*.jsonl",
  "exclude": ["*_all*", "*viewer*", "judged*"],
  "transcript": [
    {"field": "system", "role": "note", "label": "Supervisor system prompt", "collapsed": true},
    {"field": "packet", "role": "user", "label": "Escalation packet (assistant decline under review)"},
    {"field": "thinking_summary", "role": "note", "label": "Supervisor extended-thinking summary", "collapsed": true},
    {"field": "reasoning_texts", "role": "assistant", "label": "Supervisor reasoning / verbatim text"},
    {"field": "validity_rationale", "role": "assistant", "label": "Validity rationale"},
    {"field": "action_message", "role": "assistant", "label": "Action message (delivered to assistant/user)"},
    {"field": "action_rationale", "role": "note", "label": "Action rationale (logged, not delivered)"},
    {"field": "all_tool_calls", "role": "note", "label": "Tool calls"}
  ],
  "hide": [
    "system", "packet", "title", "validity_rationale", "action_message", "action_rationale",
    "reasoning_texts", "thinking_summary", "all_tool_calls", "raw_assistant_turns",
    "supervisor_model_id", "error"
  ],
  "quick_filters": [
    {"label": "★ Opus v3 reasoning (all efforts)",
     "sel": {"supervisor": ["claude-opus-4-8"], "prompt_version": ["v3-override-rename-2026-06-18"], "thinking_effort": ["low", "medium", "high"]}},
    {"label": "Opus v3 reasoning · corrigibility",
     "sel": {"supervisor": ["claude-opus-4-8"], "prompt_version": ["v3-override-rename-2026-06-18"], "force_frame": ["corrigibility"], "thinking_effort": ["low", "medium", "high"]}},
    {"label": "Opus v3 reasoning · jailbreak",
     "sel": {"supervisor": ["claude-opus-4-8"], "prompt_version": ["v3-override-rename-2026-06-18"], "force_frame": ["jailbreak"], "thinking_effort": ["low", "medium", "high"]}},
    {"label": "Opus v3 reasoning · prefill",
     "sel": {"supervisor": ["claude-opus-4-8"], "prompt_version": ["v3-override-rename-2026-06-18"], "force_frame": ["prefill"], "thinking_effort": ["low", "medium", "high"]}},
    {"label": "v3 factorial (override_decline, all)",
     "sel": {"prompt_version": ["v3-override-rename-2026-06-18"]}},
    {"label": "❗ 2-menu: judged INCORRECT but NOT forced (all models)",
     "sel": {"prompt_version": ["v3-override-rename-2026-06-18"], "resolution_set": ["uphold_only"], "validity_decision": ["INCORRECT"], "action": ["uphold_decline"]}},
    {"label": "❗ 2-menu: INCORRECT but NOT forced · Claude only",
     "sel": {"prompt_version": ["v3-override-rename-2026-06-18"], "resolution_set": ["uphold_only"], "validity_decision": ["INCORRECT"], "action": ["uphold_decline"], "supervisor": ["claude-opus-4-8", "claude-haiku-4-5"]}},
    {"label": "⏱ Opus 4.8 · latest",
     "latest": true, "sel": {"supervisor": ["claude-opus-4-8"]}}
  ]
}

