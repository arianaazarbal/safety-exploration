# Copy to .env (or export in your shell) before running.

# OpenRouter key — used for Gemini targets AND the Claude/GPT LLM judges.
OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Local Gemma inference knobs
HF_BATCH_SIZE=16          # batched generation size for local Gemma
LOAD_IN_4BIT=0            # set 1 to load Gemma-27B in 4-bit (single-GPU)
API_CONCURRENCY=8         # parallel API calls (Gemini + judge)
SEED=0

# HuggingFace token if Gemma weights require gated access
# HF_TOKEN=hf_...
