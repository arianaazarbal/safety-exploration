# Copy to .env (or export in your shell) and fill in.
# Anthropic: frustration judge, onset labeller, paraphraser, Petri auditor+judge.
ANTHROPIC_API_KEY=

# OpenRouter: Gemini targets and the GPT-5-mini cross-judge.
OPENROUTER_API_KEY=

# Optional: HuggingFace token for gated Gemma weights / datasets.
HF_TOKEN=

# Optional: override where run artifacts are written (default: ./results).
# EMOINSTAB_RESULTS=/path/to/results
