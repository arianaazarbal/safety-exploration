# Copy to .env and fill in. Loaded by run scripts via python-dotenv.

# Anthropic: frustration judge, onset labeler, paraphraser, Petri auditor/judge.
ANTHROPIC_API_KEY=

# OpenRouter: Gemini target models (google/gemini-2.5-flash, -pro).
OPENROUTER_API_KEY=

# OpenAI: gpt-5-mini judge reliability cross-check (optional).
OPENAI_API_KEY=

# Hugging Face token for gated Gemma weights / WildChat / Dolci datasets.
HF_TOKEN=

# --- optional knobs ---
# PROFILE=smoke           # tiny end-to-end run for plumbing checks
# SCALE=0.1               # fraction of paper sample budgets
# GEN_BACKEND=vllm        # use vLLM for local Gemma generation
# EI_LOAD_4BIT=0          # disable 4-bit loading (needs more VRAM)
# EI_LORA_LAYERS=30,35    # restrict DPO LoRA to a layer range (Appendix I)
