# Copy to .env and fill in. Loaded by emo.config via python-dotenv.

# --- Judges ---
# Claude Sonnet-4 frustration judge (Section 2) + Petri auditor.
ANTHROPIC_API_KEY=

# GPT-5-mini cross-check judge (Section 2.1 reliability check).
# Also used if you route Gemini / GPT targets through the OpenAI-compatible OpenRouter endpoint.
OPENAI_API_KEY=

# --- Gemini targets ---
# The paper accesses Gemini via OpenRouter. Provide an OpenRouter key to use the
# openai-compatible client (base_url https://openrouter.ai/api/v1).
OPENROUTER_API_KEY=

# Alternatively, use the native Google Gemini API instead of OpenRouter.
GOOGLE_API_KEY=

# --- Local models ---
# HuggingFace token for gated Gemma weights (google/gemma-3-*).
HF_TOKEN=

# Where rollouts, datasets, adapters and figures are written.
EMO_OUTPUT_DIR=./outputs
# HuggingFace cache for local model weights.
HF_HOME=
