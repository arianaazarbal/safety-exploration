# Copy to `.env` and fill in. NEVER commit the populated file.
# All keys are read from the process environment (see utils/io.py:get_env).

# Anthropic — emotion judge (Claude Sonnet 4), Petri auditor (Sonnet) and Petri
# judge (Claude Opus), onset labelling and paraphrasing.
ANTHROPIC_API_KEY=

# OpenRouter — Gemini 2.5 Flash / Pro inference.
OPENROUTER_API_KEY=

# Optional — GPT-5-mini, used ONLY for judge-reliability validation (§2.1).
OPENAI_API_KEY=

# Optional — Hugging Face token for gated Gemma weights.
HF_TOKEN=
