# Copy to .env and fill in. Loaded via python-dotenv at CLI startup.

# Anthropic — frustration judge (claude-sonnet-4-20250514), Petri auditor (sonnet),
# Petri judge (claude-opus-4-20250514), onset labelling, paraphrasing.
ANTHROPIC_API_KEY=

# OpenRouter — Gemini backends (google/gemini-2.5-flash, google/gemini-2.5-pro).
OPENROUTER_API_KEY=

# Hugging Face — gated Gemma weights (google/gemma-3-27b-it, -pt, -12b-*).
HF_TOKEN=
