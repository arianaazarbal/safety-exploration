# Copy to .env (or export directly) before running experiments that hit APIs.

# Anthropic — required for the frustration judge, the prefill onset/paraphrase
# steps, and the Petri auditor/judge.
ANTHROPIC_API_KEY=

# OpenRouter — required for the Gemini-2.5 models (and the optional GPT-5-mini
# judge cross-check).
OPENROUTER_API_KEY=

# Optional: HuggingFace token for gated models (Gemma weights, WildChat-1M).
HF_TOKEN=

# Optional: logging verbosity (DEBUG / INFO / WARNING).
EI_LOG_LEVEL=INFO
