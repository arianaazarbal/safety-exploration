# Copy to .env and fill in. Loaded via python-dotenv / your shell.

# Claude judge, onset labelling, paraphrasing, Petri auditor+judge (Anthropic).
ANTHROPIC_API_KEY=

# Gemini-2.5-Flash / -Pro served through OpenRouter (Appendix B.1).
OPENROUTER_API_KEY=

# HuggingFace token for gated Gemma weights and WildChat/Dolci datasets.
HF_TOKEN=

# Optional overrides
# GNH_DATA_DIR=/path/to/artifacts        # where rollouts/results/checkpoints go
# GNH_API_CONCURRENCY=8                   # judge/API concurrency
