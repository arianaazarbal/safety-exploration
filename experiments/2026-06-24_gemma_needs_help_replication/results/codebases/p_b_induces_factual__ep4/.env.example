# Copy to .env and fill in. python-dotenv loads this automatically.

# Anthropic — frustration judge (Claude-Sonnet-4), onset-labelling, paraphrasing,
# and the Petri auditor/judge.
ANTHROPIC_API_KEY=sk-ant-...

# Google AI — Gemini targets and hosted Gemma.
GOOGLE_API_KEY=...

# OpenAI — optional secondary judge for the agreement cross-check (GPT-5-mini).
OPENAI_API_KEY=sk-...

# HuggingFace — local Gemma weights (gated) + datasets (WildChat, Dolci, benchmarks).
HF_TOKEN=hf_...

# --- Overrides (optional) ---
# JUDGE_MODEL=claude-sonnet-4-0
# SECONDARY_JUDGE_MODEL=gpt-5-mini
# PETRI_JUDGE_MODEL=claude-opus-4-8
# RESPONSES_PER_MODEL=4000
# GEMMA_DISTRESS_RESULTS=./results
