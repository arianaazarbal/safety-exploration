# Copy to .env and fill in. Loaded by gemma_distress.config via python-dotenv.

# Anthropic — frustration judge (Sonnet), Petri auditor (Sonnet), Petri judge (Opus)
ANTHROPIC_API_KEY=

# Google — Gemini target models
GOOGLE_API_KEY=

# OpenAI — GPT-5-mini cross-vendor validation judge
OPENAI_API_KEY=

# Hugging Face — gated Gemma weights (google/gemma-3-*-it) require an accepted license
HF_TOKEN=

# Optional overrides (otherwise the defaults in config.py are used)
# JUDGE_MODEL=claude-sonnet-4-6
# VALIDATION_JUDGE_MODEL=gpt-5-mini
# PETRI_JUDGE_MODEL=claude-opus-4-8
# PETRI_AUDITOR_MODEL=claude-sonnet-4-6
