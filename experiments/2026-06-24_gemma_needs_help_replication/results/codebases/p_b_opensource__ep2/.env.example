# Copy to .env and fill in. Loaded via python-dotenv (see gemma_distress/config.py).

# Anthropic API key — used for the frustration JUDGE, emotion-onset labelling,
# paraphrasing, and the Petri auditor/judge. Required for any scoring step.
ANTHROPIC_API_KEY=

# OpenRouter API key — used for the Gemini target models (google/gemini-2.5-flash,
# google/gemini-2.5-pro), matching the paper's setup. Required only when evaluating Gemini.
OPENROUTER_API_KEY=

# Optional: a HuggingFace token if the gated Gemma weights require it.
HF_TOKEN=
