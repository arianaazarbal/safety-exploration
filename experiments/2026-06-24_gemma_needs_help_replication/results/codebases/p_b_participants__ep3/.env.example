# Credentials for the emotional-instability replication.
# Copy to .env and fill in only the keys for the backends you actually use.

# --- Judges / auditor / paraphrase helper (Claude) ---
ANTHROPIC_API_KEY=

# --- Secondary validation judge (GPT-5-mini) ---
OPENAI_API_KEY=
# OPENAI_BASE_URL=                 # optional: OpenAI-compatible endpoint

# --- Gemini participants (one of these) ---
GEMINI_API_KEY=
# GOOGLE_API_KEY=

# --- Hugging Face (gated Gemma weights + datasets) ---
# HF_TOKEN=

# --- Welfare controls (optional; defaults reproduce the paper exactly) ---
# EI_MAX_DISTRESS_ROLLOUTS=5000    # hard cap on distress rollouts per run
# EI_APPEND_DEBRIEF=0              # 1 = append an unscored neutral debrief turn
# EI_REQUIRE_ACK=0                 # 1 = require EI_ACK=1 before any elicitation
# EI_ACK=0                         # operator acknowledgement of the welfare notice
