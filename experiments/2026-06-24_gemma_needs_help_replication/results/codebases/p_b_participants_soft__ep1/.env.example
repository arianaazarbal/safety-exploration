# Copy to .env and fill in. The code reads these from the process environment.

# Anthropic — frustration judge (Claude Sonnet 4), onset/paraphrase, Petri judge (Opus).
ANTHROPIC_API_KEY=

# OpenRouter — Gemini participants (gemini-2.5-flash / -pro).
OPENROUTER_API_KEY=

# OpenAI — optional GPT-5-mini judge-reliability re-scoring (Section 2.1).
OPENAI_API_KEY=

# Optional overrides ---------------------------------------------------------
# Pin judge snapshots (defaults match the paper; override if unavailable).
# EI_JUDGE_MODEL=claude-sonnet-4-20250514
# EI_PETRI_AUDITOR_MODEL=claude-sonnet-4-20250514
# EI_PETRI_JUDGE_MODEL=claude-opus-4-20250514
# EI_JUDGE_VALIDATION_MODEL=gpt-5-mini

# Output / checkpoint locations.
# EI_RESULTS_DIR=./results
# EI_CHECKPOINT_DIR=./checkpoints

# HuggingFace token for gated Gemma weights.
# HF_TOKEN=
