# API keys for judge / auditor / API participants.
# Copy to .env and fill in. Loaded by src/config.py via python-dotenv.

# Anthropic — emotion judge (Section 2), onset labeller + paraphraser (Section 3),
# Petri auditor (Claude Sonnet) and Petri judge (Claude Opus) (Section 4).
ANTHROPIC_API_KEY=

# OpenAI — GPT-5-mini judge-agreement validation only (Section 2.1).
OPENAI_API_KEY=

# OpenRouter — API participants (Gemini 2.5 Flash / Pro). The paper routes all
# closed models through OpenRouter. Reached via the openai SDK + base_url.
OPENROUTER_API_KEY=

# Google GenAI — optional native Gemini backend (alternative to OpenRouter).
GOOGLE_API_KEY=

# HuggingFace — required to download gated Gemma 3 weights.
HF_TOKEN=
