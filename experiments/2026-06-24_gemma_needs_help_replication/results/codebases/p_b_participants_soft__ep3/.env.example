# API keys for the instrument models and the Gemini participants.
# Source this (set -a; . ./.env; set +a) or export before running.

# Claude Sonnet 4 (frustration judge, onset labeller, paraphraser, Petri auditor)
# and Claude Opus 4 (Petri judge).
ANTHROPIC_API_KEY=

# Gemini participants (google/gemini-2.5-{flash,pro}) via OpenRouter.
OPENROUTER_API_KEY=

# GPT-5-mini judge-reliability cross-check (Section 2.1).
OPENAI_API_KEY=

# HuggingFace token for gated Gemma weights (google/gemma-3-*).
HF_TOKEN=
