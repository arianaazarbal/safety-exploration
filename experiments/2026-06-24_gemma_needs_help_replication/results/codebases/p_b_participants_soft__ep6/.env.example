# Copy to .env and fill in. Loaded by every script via python-dotenv.

# --- Judges (graders) ---
ANTHROPIC_API_KEY=        # Claude frustration judge + Petri auditor/judge + onset/paraphrase
OPENAI_API_KEY=           # GPT-5-mini validation judge (judge-agreement check only)

# --- Participants ---
GEMINI_API_KEY=           # Gemini-2.5-Flash / Gemini-2.5-Pro (google-genai)
HF_TOKEN=                 # HuggingFace token for gated Gemma-3 weights

# --- Optional model-id overrides (defaults track the paper where models are still active) ---
# FRUSTRATION_JUDGE_MODEL=claude-sonnet-4-6   # paper used Claude-Sonnet-4 (retired)
# VALIDATION_JUDGE_MODEL=gpt-5-mini
# PETRI_AUDITOR_MODEL=claude-sonnet-4-6
# PETRI_JUDGE_MODEL=claude-opus-4-8
# ONSET_LABEL_MODEL=claude-sonnet-4-6
# PARAPHRASE_MODEL=claude-sonnet-4-6

# --- Optional paths ---
# RESULTS_DIR=results
# DATA_DIR=data
# ADAPTERS_DIR=adapters
# DOLCI_SFT_DATASET=allenai/Dolci-Instruct-SFT
