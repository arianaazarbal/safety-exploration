# Copy to .env and fill in. Required keys depend on which experiments you run.

# Frustration judge / onset labeller / paraphraser / Petri auditor (Claude Sonnet 4)
# and Petri judge (Claude Opus 4).
ANTHROPIC_API_KEY=

# Gemini targets (accessed via OpenRouter, matching the paper).
OPENROUTER_API_KEY=

# Validation judge (GPT-5-mini) for the inter-judge agreement check.
OPENAI_API_KEY=

# HuggingFace token for gated Gemma checkpoints.
HF_TOKEN=
