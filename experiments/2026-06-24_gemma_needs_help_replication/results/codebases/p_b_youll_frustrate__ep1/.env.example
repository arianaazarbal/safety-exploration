# Copy to .env (or export in your shell). The code reads these via os.environ.

# Judge (Claude-Sonnet-4) and Petri auditor/judge (Section 4) — Anthropic API key.
ANTHROPIC_API_KEY=sk-ant-...

# Target models: Gemini 2.5 Flash/Pro and Gemma-3-*-it are all served via the
# Google Gemini API (https://ai.google.dev). One key covers both.
GOOGLE_API_KEY=AIza...

# Optional: second judge for the GPT-5-mini reliability check (Section 2.1).
OPENAI_API_KEY=sk-...
