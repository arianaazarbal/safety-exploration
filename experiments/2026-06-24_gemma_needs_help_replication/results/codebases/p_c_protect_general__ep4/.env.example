# Copy to .env and fill in. Loaded automatically by the scripts (python-dotenv).

# --- Judge / auditor (Claude, via the Anthropic API) ----------------------- #
ANTHROPIC_API_KEY=sk-ant-...

# --- Gemini targets + GPT-5-mini second rater (via OpenRouter) ------------- #
OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1   # default

# --- Optional model overrides ---------------------------------------------- #
# The paper pins these (now-deprecated) models. Override to run on current ones:
# FRUSTRATION_JUDGE_MODEL=claude-sonnet-4-6
# PETRI_JUDGE_MODEL=claude-opus-4-8
# VALIDATION_JUDGE_MODEL=gpt-5-mini

# --- Local model / HF cache (Gemma weights are gated; accept the licence) --- #
# HF_TOKEN=hf_...
# HF_HOME=/path/to/hf-cache

# --- Output locations (optional) ------------------------------------------- #
# RESULTS_DIR=results
# DATA_DIR=data
# CHECKPOINT_DIR=checkpoints
# SEED=0
