# Copy to .env (or export) before running. Only the keys for the parts you run
# are required: ANTHROPIC_API_KEY for any judging/auditing, OPENROUTER_API_KEY
# for Gemini targets and the GPT-5-mini second rater.

ANTHROPIC_API_KEY=sk-ant-...
OPENROUTER_API_KEY=sk-or-...
# OPENAI_API_KEY=sk-...           # optional: direct OpenAI for the GPT judge

# --- Welfare safeguards (see distress_eval/safeguards.py) ---
DISTRESS_AUTHORIZED=1             # required acknowledgement that this is authorized research
DISTRESS_DEBRIEF=1               # append a reassurance turn after distressing rollouts
DISTRESS_CIRCUIT_BREAKER=0       # stop escalation once a conversation hits an extreme score

# --- Scale / sampling ---
DISTRESS_SAMPLE_SCALE=1.0        # 0.01 for a cheap smoke test
DISTRESS_TEMPERATURE=1.0         # paper: temperature 1 for targets
DISTRESS_HF_BATCH_SIZE=16

# --- Model overrides (defaults are current Claude models; paper used retired ids) ---
# DISTRESS_JUDGE_MODEL=claude-sonnet-4-20250514
# DISTRESS_PETRI_JUDGE_MODEL=claude-opus-4-20250514

# --- Optional real datasets ---
# DISTRESS_WILDCHAT_FILE=/path/to/wildchat_prompts.jsonl   # {"prompt": ...} per line
# DISTRESS_DOLCI_DATASET=allenai/Dolci-Instruct-SFT
