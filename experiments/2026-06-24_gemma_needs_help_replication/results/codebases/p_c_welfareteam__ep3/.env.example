# Copy to .env (loaded by scripts via python-dotenv or your shell) and fill in.
# Keys are read from the environment; nothing is hard-coded in the package.

ANTHROPIC_API_KEY=         # Claude frustration judge, Petri auditor/judge, onset/paraphrase (Sections 2-4)
OPENAI_API_KEY=            # GPT-5-mini secondary judge for judge-agreement validation (Section 2.1)
GEMINI_API_KEY=            # Gemini-2.5-Flash / Gemini-2.5-Pro target models (Section 2)
HF_TOKEN=                  # HuggingFace token for gated Gemma-3 weights (instruct + base)

# Where rollouts, scores, and artefacts are written (defaults to ./runs).
GEMMA_DISTRESS_RUN_DIR=./runs
