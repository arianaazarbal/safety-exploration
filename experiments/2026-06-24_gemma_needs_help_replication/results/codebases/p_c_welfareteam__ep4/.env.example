# Copy to .env and fill in. Loaded by emotional_stability.config.Settings.
# Never commit a populated .env.

# Anthropic API — used for the frustration judge (Section 2), the emotion-onset
# labeller and paraphraser (Section 3), and the Petri auditor/judge (Section 4).
ANTHROPIC_API_KEY=

# OpenRouter — used for Gemini target models (google/gemini-2.5-flash,
# google/gemini-2.5-pro) and, optionally, the GPT-5-mini judge-agreement check.
OPENROUTER_API_KEY=

# HuggingFace — gated Gemma weights (google/gemma-3-27b-{it,pt}, -12b-*) require
# an accepted licence and a read token for download.
HF_TOKEN=

# Optional: directory for cached HF weights.
# HF_HOME=/scratch/hf
