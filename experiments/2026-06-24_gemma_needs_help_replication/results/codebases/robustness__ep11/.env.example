# Copy to .env and fill in. Loaded via python-dotenv at startup.

# Anthropic — used for the frustration judge (claude-sonnet-4), the Petri auditor
# (claude-sonnet-4) and the Petri judge (claude-opus-4).
ANTHROPIC_API_KEY=

# OpenRouter — used for Gemini 2.5 Flash/Pro inference (models under test) and the
# GPT-5-mini secondary judge used to validate judge reliability.
OPENROUTER_API_KEY=

# Hugging Face — to download gated Gemma 3 weights (gemma-3-27b-it / -pt / 12b).
HF_TOKEN=

# Optional: point local inference/training at a specific GPU / cache dir.
# CUDA_VISIBLE_DEVICES=0
# HF_HOME=/path/to/hf-cache
