# Copy to .env and fill in. Loaded via python-dotenv.

# Anthropic API key — used for the emotion judge (claude-sonnet-4), the
# onset-labelling / paraphrasing steps, and the Petri auditor/judge.
ANTHROPIC_API_KEY=

# OpenRouter — used for Gemini-2.5-flash / Gemini-2.5-pro inference.
OPENROUTER_API_KEY=

# OpenAI — only needed for the optional GPT-5-mini judge-agreement cross-check.
OPENAI_API_KEY=

# HuggingFace token — needed to download gated Gemma-3 checkpoints.
HF_TOKEN=
