# Copy to .env and fill in. Loaded via python-dotenv in the scripts.

# Claude judge (Section 2), onset/paraphrase labeller (Section 3),
# Petri auditor (Sonnet) + judge (Opus).
ANTHROPIC_API_KEY=

# Secondary frustration judge (GPT-5-mini) for the reliability check.
OPENAI_API_KEY=

# Gemini targets (and any other OpenRouter-served models). Default Gemini path.
OPENROUTER_API_KEY=

# Optional: native Gemini backend instead of OpenRouter.
GOOGLE_API_KEY=

# Optional: HF token for gated Gemma weights (local inference / training).
HF_TOKEN=
