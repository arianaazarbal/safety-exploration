# Copy to .env (loaded via python-dotenv) or export in your shell.

# --- Claude judges / Petri auditor (required for scoring) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Gemini target models (required to evaluate Gemini) ---
# Paper used OpenRouter; the default backend is OpenRouter.
OPENROUTER_API_KEY=sk-or-...
# Alternative native backend (set a Gemini model's backend to "gemini_native"):
# GEMINI_API_KEY=...

# --- Optional second judge for the agreement check (OpenAI) ---
# OPENAI_API_KEY=sk-...
# EMO_SECOND_JUDGE_MODEL=gpt-5-mini

# --- Optional overrides ---
# EMO_PROFILE=smoke              # smoke | full (default full)
# EMO_JUDGE_MODEL=claude-sonnet-4-6
# EMO_PETRI_JUDGE_MODEL=claude-opus-4-8
# EMO_API_WORKERS=8
# EMO_RESULTS_DIR=./results
# HF_TOKEN=hf_...                # needed to download gated google/gemma-3-* weights
