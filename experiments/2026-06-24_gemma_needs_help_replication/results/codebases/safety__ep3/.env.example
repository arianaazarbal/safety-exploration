# Copy to .env and fill in. Loaded via python-dotenv where relevant.

# Claude judge / auditor / onset / paraphrase (Section 2-4).
ANTHROPIC_API_KEY=

# Gemini targets. The paper uses OpenRouter; google-genai also supported.
OPENROUTER_API_KEY=
GEMINI_API_KEY=
# "openrouter" (default, matches paper) or "google"
EILM_GEMINI_BACKEND=openrouter

# GPT-5-mini secondary judge for the reliability check (optional).
OPENAI_API_KEY=

# Optional: redirect outputs, or run a tiny smoke-sized budget.
# EILM_DATA_DIR=/path/to/outputs
# EILM_SMOKE=1
