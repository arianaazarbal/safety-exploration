# Copy to .env and fill in. Loaded automatically by config.py (python-dotenv).

# --- Anthropic (frustration judge, onset/paraphrase, Petri auditor+judge) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- OpenRouter (Gemini 2.5 Flash / Pro) ---
OPENROUTER_API_KEY=sk-or-...

# --- OpenAI (only for judge-agreement validation with GPT-5-mini) ---
OPENAI_API_KEY=sk-...

# --- HuggingFace (gated Gemma weights + some benchmark datasets) ---
HF_TOKEN=hf_...

# --- Optional toggles ---
# Use the paper's exact (now-retired) judge snapshots instead of current models.
# USE_PAPER_JUDGE_SNAPSHOTS=1
# Fraction of the paper's 4000 responses/model (0.02 ~ quick smoke test).
# EVAL_SCALE=1.0
# JUDGE_CONCURRENCY=8
# OPENROUTER_CONCURRENCY=8
