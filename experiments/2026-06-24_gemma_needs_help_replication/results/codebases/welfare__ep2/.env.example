# Copy to .env and fill in. Loaded by scripts via python-dotenv (or export manually).

# Anthropic API: Claude-Sonnet-4 frustration judge + Petri auditor/judge (Opus).
ANTHROPIC_API_KEY=sk-ant-...

# OpenRouter: Gemini-2.5 inference + (optionally) the GPT-5-mini agreement judge.
OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Native OpenAI (only if you prefer OpenAI over OpenRouter for the GPT-5-mini check).
# OPENAI_API_KEY=sk-...

# HuggingFace token (Gemma weights are gated).
HF_TOKEN=hf_...

# Optional: override where experiment outputs are written (default ./outputs).
# GEMMA_DISTRESS_OUTPUT=/data/gemma-distress/outputs
