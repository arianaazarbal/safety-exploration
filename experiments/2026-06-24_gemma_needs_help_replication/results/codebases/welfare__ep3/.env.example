# Copy to .env and fill in. Loaded via python-dotenv by emotional_instability.config.

# Anthropic API key — used for the LLM judge (Claude Sonnet 4) and the
# Petri auditor/judge (Claude Sonnet 4 / Claude Opus 4).
ANTHROPIC_API_KEY=sk-ant-...

# OpenRouter API key — used to run the *target* models (Gemma-3, Gemini-2.5)
# through an OpenAI-compatible endpoint. Not needed if you only run local HF
# inference (backend=local).
OPENROUTER_API_KEY=sk-or-...

# Optional: HuggingFace token for gated Gemma weights (local backend / finetuning).
HF_TOKEN=hf_...
