# Copy to .env and fill in (or export these in your shell).

# Claude frustration judge + Petri auditor/judge (always required).
ANTHROPIC_API_KEY=

# Gemini targets (gemini-2.5-flash / -pro).
GOOGLE_API_KEY=

# --- optional judge overrides ---
# Reproduce the paper's exact judge (subject to availability):
#   EMOTIONEVAL_JUDGE_MODEL=claude-sonnet-4-0
# Second judge used for the reliability check (default: claude-opus-4-5):
#   EMOTIONEVAL_JUDGE_MODEL_2=claude-opus-4-5

# Gemma (open-weight) targets need HuggingFace access instead of an API key:
#   huggingface-cli login
