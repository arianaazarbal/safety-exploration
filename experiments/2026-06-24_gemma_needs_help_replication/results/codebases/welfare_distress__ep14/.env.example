# Copy to .env and fill in the keys for the backends you use.

# --- Emotion judge (required): Claude-Sonnet-4 via the Anthropic API ---
ANTHROPIC_API_KEY=

# --- Target models ---
# Google AI / Gemini API. Serves both Gemini (gemini-2.5-*) and Gemma (gemma-3-*-it).
GOOGLE_API_KEY=
# (GEMINI_API_KEY is accepted as an alias.)

# OpenRouter (only if you set GEMINI_BACKEND=openrouter or GEMMA_BACKEND=openrouter).
OPENROUTER_API_KEY=

# --- Backend selection (optional) ---
# google (default) | openrouter | hf
# GEMMA_BACKEND=google
# GEMINI_BACKEND=google

# --- Run controls (optional) ---
# Scale down for a cheap smoke test (1.0 = full ~4000 responses/model).
# EVAL_SCALE=0.01
# EVAL_SEED=0
# EVAL_MAX_WORKERS=8
# JUDGE_MODEL=claude-sonnet-4-20250514
