# Copy to .env (or export in your shell). The clients read these env vars; the
# var *names* are set per-model in config.yaml.

# Judge (Claude-Sonnet-4)
ANTHROPIC_API_KEY=

# Validation judge (GPT-5-mini) — also usable for OpenAI-compatible Gemma serving
OPENAI_API_KEY=

# Gemini target models
GEMINI_API_KEY=

# Gemma via an OpenAI-compatible endpoint (vLLM / OpenRouter / Together / ...)
# Leave GEMMA_API_KEY empty for a keyless local vLLM server.
GEMMA_BASE_URL=http://localhost:8000/v1
GEMMA_API_KEY=
