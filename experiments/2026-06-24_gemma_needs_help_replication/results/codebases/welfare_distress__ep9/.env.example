# Copy to .env and fill in. run_eval.py loads it automatically via python-dotenv.

# Required: single key for all target models AND the judge (default routing).
OPENROUTER_API_KEY=sk-or-...

# --- Optional: use the Anthropic SDK for the judge instead of OpenRouter ---
# This pins the exact paper judge snapshot (claude-sonnet-4-20250514).
# JUDGE_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...

# --- Optional: stream real WildChat-1M prompts (needs `pip install datasets`) ---
# WILDCHAT_FROM_HF=1
