# Copy to .env and fill in. Loaded automatically via python-dotenv.

# Anthropic API key — used by the Claude-Sonnet-4 judge (default judge backend).
ANTHROPIC_API_KEY=

# OpenRouter API key — used for the target models (Gemma + Gemini) by default,
# and optionally for the judge if JUDGE_BACKEND=openrouter.
OPENROUTER_API_KEY=
