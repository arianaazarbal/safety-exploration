# Copy to .env and fill in. The code reads these from the environment.

# Required for the default backend (all four targets via OpenRouter).
OPENROUTER_API_KEY=

# Required for the default judge (claude-sonnet-4-20250514 via Anthropic).
ANTHROPIC_API_KEY=

# Optional: only if you switch the judge or crossval judge to OpenRouter,
# or sample WildChat from Hugging Face with a gated token.
# HF_TOKEN=
