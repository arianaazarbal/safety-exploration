# Copy to .env and fill in. All models (Gemma, Gemini, Claude judge) route
# through OpenRouter, so a single key is required.
OPENROUTER_API_KEY=sk-or-...

# Optional overrides (defaults in config.py):
# DISTRESS_SCALE=0.02          # fraction of paper scale; start small
# DISTRESS_SEED=0              # RNG seed for puzzle/rejection/WildChat sampling
# DISTRESS_OUTPUT_DIR=results  # where responses.jsonl + summary/ are written
