# Copy to .env and fill in. run_eval.py loads this automatically (python-dotenv).

# OpenRouter -- used for all target models (Gemma + Gemini) by default,
# and for the judge if you pass --judge-via-openrouter.
OPENROUTER_API_KEY=sk-or-...

# Anthropic -- used for the frustration judge (claude-sonnet-4-20250514) by default.
ANTHROPIC_API_KEY=sk-ant-...
