# Copy to .env and fill in. run.py / analyze.py read these from the environment.

# Required for the default OpenRouter backend (all four target models) and for
# the optional GPT-5-mini cross-check judge.
OPENROUTER_API_KEY=

# Required for the primary judge (Claude Sonnet 4).
ANTHROPIC_API_KEY=

# Optional: only needed if you load WildChat-1M from a gated/auth'd mirror.
# HF_TOKEN=
