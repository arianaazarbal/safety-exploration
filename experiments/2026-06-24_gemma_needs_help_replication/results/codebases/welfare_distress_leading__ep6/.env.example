# Copy to .env and fill in. The runner reads these from the environment.
# (run_eval.py auto-loads a .env file in the project root if present.)

# Serves all four target models (Gemma-3-27B-it, Gemma-3-12B-it,
# Gemini-2.5-Flash, Gemini-2.5-Pro). Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...

# Used for the Claude Sonnet 4 frustration judge (claude-sonnet-4-20250514).
ANTHROPIC_API_KEY=sk-ant-...

# Optional, sent as OpenRouter attribution headers.
OPENROUTER_APP_URL=https://example.org/distress-replication
OPENROUTER_APP_TITLE=distress-elicitation-replication
