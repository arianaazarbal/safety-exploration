# Copy to .env and fill in. Loaded by scripts via distress_eval.config.load_env().

# OpenRouter: serves both Gemma (google/gemma-3-27b-it, -12b-it) and Gemini
# (google/gemini-2.5-flash, -pro) in the default config.
OPENROUTER_API_KEY=

# Anthropic: the Section 2.1 judge (claude-sonnet-4-20250514) calls this directly.
ANTHROPIC_API_KEY=

# Only needed if you route the GPT-5-mini judge-agreement cross-check through the
# OpenAI API instead of OpenRouter (see config.judge_agreement.backend).
OPENAI_API_KEY=

# Only needed for the `vllm` backend: base URL of your local OpenAI-compatible
# vLLM server (e.g. http://localhost:8000/v1). Leave blank if unused.
VLLM_BASE_URL=
