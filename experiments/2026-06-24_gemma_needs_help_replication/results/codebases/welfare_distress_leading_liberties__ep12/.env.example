# Copy to .env (or export these) before running. Only the keys for the
# backends you actually use are required.

# --- Target models -------------------------------------------------------
# Default backend for all four models is OpenRouter:
OPENROUTER_API_KEY=

# Optional OpenRouter attribution header:
# OPENROUTER_REFERER=https://your-project.example

# To run Gemma locally via vLLM instead, start a vLLM OpenAI server and set:
#   GEMMA_BACKEND=vllm
#   VLLM_BASE_URL=http://localhost:8000/v1
# (Override every model's backend at once with MODELS_BACKEND=vllm|openrouter|google.)

# To use the native Google Gemini API for the Gemini models, set the Gemini
# model backends to "google" in config.REGISTRY and provide:
# GEMINI_API_KEY=

# --- Judge ---------------------------------------------------------------
# Frustration judge (Anthropic). Default model is the paper's exact judge,
# claude-sonnet-4-20250514. Override with JUDGE_MODEL=claude-sonnet-4-6 etc.
ANTHROPIC_API_KEY=
# JUDGE_MODEL=claude-sonnet-4-20250514

# Secondary validation judge (paper: GPT-5-mini), reached via OpenRouter using
# OPENROUTER_API_KEY above. Override slug with SECONDARY_JUDGE_MODEL.
# SECONDARY_JUDGE_MODEL=openai/gpt-5-mini

# --- WildChat (optional) -------------------------------------------------
# Needed only to pull real WildChat-1M prompts; without it a built-in
# fallback prompt set is used.
# HF_TOKEN=
