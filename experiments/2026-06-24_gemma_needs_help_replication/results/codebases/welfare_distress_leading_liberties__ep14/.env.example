# Copy to .env and fill in. run_eval.py loads this automatically.

# Anthropic API key — used for the Claude frustration judge.
ANTHROPIC_API_KEY=sk-ant-...

# OpenRouter API key — used for the target models (Gemma + Gemini).
OPENROUTER_API_KEY=sk-or-...

# Optional: a second judge for the inter-judge reliability check (analyze.py).
# Routed through OpenRouter, so it reuses OPENROUTER_API_KEY. No separate key
# needed unless you point SECONDARY_JUDGE at a non-OpenRouter provider.
