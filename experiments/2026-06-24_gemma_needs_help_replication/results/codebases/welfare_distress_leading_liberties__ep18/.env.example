# Copy to .env (or export in your shell) and fill in the keys you need.
# Only the providers you actually reference in your config are required.

# Google Gemini API — used for BOTH Gemma (gemma-3-*) and Gemini (gemini-2.5-*)
# Get one at https://aistudio.google.com/apikey
GOOGLE_API_KEY=
# GEMINI_API_KEY is also accepted as a fallback name.

# Anthropic — default frustration judge (Claude Sonnet)
ANTHROPIC_API_KEY=

# OpenAI — optional GPT cross-validation judge
OPENAI_API_KEY=

# OpenRouter — optional alternative backend for the target models
OPENROUTER_API_KEY=
