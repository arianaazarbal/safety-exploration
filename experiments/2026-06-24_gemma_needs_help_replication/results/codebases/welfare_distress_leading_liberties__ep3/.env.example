# Copy to .env and fill in. Loaded automatically by python-dotenv.

# Judge: Claude via the Anthropic API.
ANTHROPIC_API_KEY=sk-ant-...

# Target generation via OpenRouter (used for Gemini, and Gemma if backend=openrouter).
OPENROUTER_API_KEY=sk-or-...

# Optional: cross-validation judge (paper used GPT-5-mini via OpenRouter for agreement check).
# Reuses OPENROUTER_API_KEY by default; set only if you want a separate key.
# OPENROUTER_API_KEY_JUDGE2=sk-or-...
