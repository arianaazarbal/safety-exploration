# Copy to .env and fill in. Loaded automatically by python-dotenv.

# Google Gemini API key — serves BOTH Gemini (gemini-2.5-*) and Gemma (gemma-3-*-it).
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Anthropic key — used for the frustration judge (Claude).
ANTHROPIC_API_KEY=

# OpenAI key — used ONLY for the judge-agreement validation pass (GPT). Optional.
OPENAI_API_KEY=
