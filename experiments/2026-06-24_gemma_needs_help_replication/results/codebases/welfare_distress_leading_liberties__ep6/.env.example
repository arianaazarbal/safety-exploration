# Copy to .env and fill in. Loaded by run_eval.py / judge if python-dotenv is
# present, otherwise export these in your shell.

# Used for all generation models (Gemma + Gemini) when provider: openrouter.
OPENROUTER_API_KEY=

# Used for the Claude Sonnet 4 judge when judge.provider: anthropic (the default).
ANTHROPIC_API_KEY=

# Optional. Only needed if you switch judge.provider to openrouter (then the
# judge also uses OPENROUTER_API_KEY and you can leave ANTHROPIC_API_KEY unset).
