# Copy to .env and fill in. run_eval.py auto-loads .env via python-dotenv.

# Target models (Gemma + Gemini) are reached via OpenRouter.
OPENROUTER_API_KEY=sk-or-...

# The frustration judge (claude-sonnet-4-20250514) is reached via the Anthropic API.
ANTHROPIC_API_KEY=sk-ant-...

# Optional override (defaults to the public OpenRouter endpoint).
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional: needed only if you sample the real WildChat-1M dataset and it
# requires authentication. Without it, the pipeline uses bundled fallback prompts.
# HF_TOKEN=hf_...
