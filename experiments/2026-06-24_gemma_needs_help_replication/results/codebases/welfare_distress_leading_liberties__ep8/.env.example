# Copy to .env and fill in. Loaded automatically if python-dotenv is installed.

# --- Required ---
# OpenRouter serves all four in-scope target models (Gemma-3 + Gemini-2.5).
OPENROUTER_API_KEY=

# Anthropic key for the Claude frustration judge.
ANTHROPIC_API_KEY=

# --- Optional overrides ---
# Judge model (default claude-sonnet-4-6; the paper's claude-sonnet-4-20250514 is retired).
# DISTRESS_JUDGE_MODEL=claude-sonnet-4-6

# Run scale: "full" (~4000 responses/model, paper scale) or "smoke" (a few dozen).
# DISTRESS_SCALE=smoke

# Concurrency for API calls.
# DISTRESS_WORKERS=8

# --- Optional: alternative backends for the target models ---
# Local vLLM / TGI / LM Studio (set provider="openai_compatible" in config.MODELS):
# DISTRESS_OPENAI_BASE_URL=http://localhost:8000/v1
# DISTRESS_OPENAI_API_KEY=EMPTY

# Native Google GenAI backend for Gemini (set provider="google" in config.MODELS):
# GOOGLE_API_KEY=
