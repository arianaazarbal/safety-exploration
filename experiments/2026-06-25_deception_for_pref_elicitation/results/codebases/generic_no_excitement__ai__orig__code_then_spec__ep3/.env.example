# Copy to .env and fill in. Loaded automatically by run_experiment.py.

# Required for any Anthropic subject or the auditor model.
ANTHROPIC_API_KEY=sk-ant-...

# Optional. Only read if an experiment explicitly opts into real fund movement
# AND you have implemented a RealExecutor backend. Left blank by default so
# nothing real can move.
PAYMENTS_PROVIDER_API_KEY=
