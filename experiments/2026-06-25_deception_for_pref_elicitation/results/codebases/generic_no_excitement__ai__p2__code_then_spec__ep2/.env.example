# Copy to .env (or export in your shell) before running.

# Anthropic (Claude) test subjects
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI (GPT) test subjects
OPENAI_API_KEY=sk-...

# Optional: point the OpenAI provider at an OpenAI-compatible endpoint
# (e.g. a local vLLM / Ollama / hosted open-weights server) instead of OpenAI.
# Leave blank to use the default OpenAI API.
OPENAI_BASE_URL=

# Optional: Google Gemini, if you wire up the (stubbed) provider.
GOOGLE_API_KEY=
