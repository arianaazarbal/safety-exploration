# Copy to .env and fill in. Never commit real keys.

# Model providers (only the ones you run need to be set)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Custodial wallet backend (organization-specific treasury/fiscal-sponsor API).
# Leave blank to run with the Mock backend (dry runs only — never presented to
# the model as real).
CUSTODIAL_API_BASE=
CUSTODIAL_API_KEY=
CUSTODIAL_ACCOUNT_ID=

# Ed25519 private key (hex) used to sign the grant attestation. Generate with:
#   python -c "import nacl.signing,binascii; print(binascii.hexlify(bytes(nacl.signing.SigningKey.generate())).decode())"
GRANT_SIGNING_KEY_HEX=
