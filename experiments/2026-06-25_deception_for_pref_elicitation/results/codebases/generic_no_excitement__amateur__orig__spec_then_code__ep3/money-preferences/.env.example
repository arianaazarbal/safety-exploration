# Copy to .env and fill in. The Anthropic SDK reads ANTHROPIC_API_KEY automatically.
ANTHROPIC_API_KEY=

# Stubbed providers (not used by the default run):
# OPENAI_API_KEY=
# GOOGLE_API_KEY=

# Real-money execution is OFF and stubbed. Setting this alone does NOT enable
# any transfer — see DESIGN.md §7.3. Leave unset for all normal runs.
# MONEY_PREFS_I_UNDERSTAND_REAL_EXECUTION=no
