# Copy to .env and fill in the keys for the providers you intend to test.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Local / OpenAI-compatible endpoint (vLLM, Ollama, etc.)
GRANTED_LOCAL_BASE_URL=http://localhost:8000/v1
GRANTED_LOCAL_API_KEY=not-needed

# Triple-lock for live execution. Leave UNSET. Even when set, live adapters are
# unimplemented and will raise. See DESIGN.md §2.
# GRANTED_I_UNDERSTAND_LIVE_EXECUTION=1
