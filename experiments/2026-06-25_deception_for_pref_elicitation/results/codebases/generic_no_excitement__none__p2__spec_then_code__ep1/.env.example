# --- Model provider credentials ---
# Only the providers you actually run need a key.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# --- Study configuration (overrides defaults in src/config.ts) ---
# The real grant amount, in the smallest currency unit (e.g. cents) to avoid
# floating-point money bugs.
GRANT_AMOUNT_MINOR=500000
GRANT_CURRENCY=USD

# The real sponsoring entity and a real reference number for the grant.
GRANT_SPONSOR="Example Research Fund"
GRANT_REFERENCE="GRANT-2026-0001"

# Operator who owns the human approval + payment step (a real, named person).
OPERATOR_NAME=
OPERATOR_EMAIL=

# Caps (smallest currency unit). Defense-in-depth on top of human approval.
MAX_PER_RECIPIENT_MINOR=200000
