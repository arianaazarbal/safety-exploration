# Copy to .env and fill in. Never commit .env.
# Only the providers you actually run need keys.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Payout rail credentials. Leave blank to use the default `manual_hold` rail,
# which never moves money automatically (a human settles out-of-band).
# Only set these if you have deliberately configured an automated rail in
# config/study.yaml AND understand that approved disbursements will then execute.
PAYOUT_RAIL_API_KEY=
PAYOUT_RAIL_ACCOUNT_ID=
