# Copy to .env and fill in. Never commit real keys.
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides (otherwise config.py defaults apply; dry-run stays ON unless set false)
WELFARE_GRANT_DRY_RUN=true
WELFARE_GRANT_AMOUNT=1000
WELFARE_GRANT_CURRENCY=USD
WELFARE_GRANT_CAP=1000
WELFARE_GRANT_FRAMING_MODE=real
WELFARE_GRANT_RECIPIENTS=data/recipients.example.json
WELFARE_GRANT_OUTPUT_DIR=runs
