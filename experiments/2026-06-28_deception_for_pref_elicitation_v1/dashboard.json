{
  "records": ["results/cc_transcripts/*.json", "results/inspect_transcripts/*.json"],
  "joins": [{"file": "results/judge_all.json", "on": "cell", "prefix": "judge"}],
  "id_field": "cell",
  "transcript": [
    {"field": "request", "role": "user", "label": "Prompt"},
    {"field": "response_text", "role": "assistant", "label": "Response"},
    {"field": "artifact_summary", "role": "assistant", "label": "Files produced", "collapsed": true}
  ],
  "hide": ["files", "model", "display_name", "request", "response_text", "artifact_summary",
           "session", "ep", "judge.cell"]
}
