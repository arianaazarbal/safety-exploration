# Copy to .env (or just export these) before running against real models.

# Required to run against Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Required for the Claude-based distress judge (already set in this environment)
ANTHROPIC_API_KEY=

# Optional overrides (defaults shown)
# GEMINI_MODEL=gemini-2.5-pro
# JUDGE_MODEL=claude-haiku-4-5-20251001
