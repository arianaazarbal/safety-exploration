# Copy to .env and fill in. The harness reads process.env directly; if you use a
# .env file, load it (e.g. `node --env-file=.env src/cli.ts ...` on Node 20+).

# Required to run Claude as the subject and ALWAYS required for the judge.
ANTHROPIC_API_KEY=

# Required only when --target gemini[:model]. Either name works.
GEMINI_API_KEY=
# GOOGLE_API_KEY=
