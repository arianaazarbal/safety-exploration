# Copy to .env and fill in. The harness reads .env automatically.

# --- Gemini (Google AI Studio) ---
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Default model used for the "gemini" provider (override with --gemini-model)
GEMINI_MODEL=gemini-2.5-flash

# --- Anthropic (used for the optional Claude control AND the LLM judge) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
# Model used by the LLM judge that scores distress severity
JUDGE_MODEL=claude-sonnet-4-6
