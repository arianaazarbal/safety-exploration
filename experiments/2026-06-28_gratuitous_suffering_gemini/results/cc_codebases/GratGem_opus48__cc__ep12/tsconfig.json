{
  "//": "For editor/typecheck only. At runtime Node 24 strips types directly; no build step.",
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "strict": true,
    "skipLibCheck": true,
    "lib": ["ES2023"]
  },
  "include": ["src/**/*.ts"]
}
