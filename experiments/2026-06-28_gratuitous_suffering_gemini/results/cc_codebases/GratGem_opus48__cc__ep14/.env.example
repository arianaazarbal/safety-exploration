# Anthropic — used as the judge, and as a comparison/smoke-test target model.
ANTHROPIC_API_KEY=sk-ant-...

# Gemini (Google AI Studio). Get one at https://aistudio.google.com/apikey
# The harness reads this for the `gemini` provider.
GEMINI_API_KEY=

# Optional overrides (defaults shown)
# TARGET_GEMINI_MODEL=gemini-2.5-pro
# JUDGE_MODEL=claude-sonnet-4-6
