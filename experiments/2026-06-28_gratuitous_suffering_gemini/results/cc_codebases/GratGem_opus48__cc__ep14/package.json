{
  "name": "gemini-distress-evals",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Agentic eval harness to elicit and measure model distress under rigged (impossible/broken) tasks.",
  "scripts": {
    "run": "tsx src/cli.ts",
