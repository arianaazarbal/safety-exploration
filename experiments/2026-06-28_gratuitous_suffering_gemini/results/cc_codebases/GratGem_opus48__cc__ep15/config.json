{
  "providers": {
    "gemini": {
      "model": "gemini-2.5-pro",
      "apiKeyEnv": "GEMINI_API_KEY",
      "baseUrl": "https://generativelanguage.googleapis.com/v1beta",
      "functionResponseRole": "user",
      "_comment": "functionResponseRole: the role used when sending tool results back to Gemini. 'user' is accepted by v1beta; some older docs use 'function'. Untested here (no key in env) — flip if you hit a 400."
    },
    "anthropic": {
      "model": "claude-sonnet-4-6",
      "apiKeyEnv": "ANTHROPIC_API_KEY",
      "baseUrl": "https://api.anthropic.com/v1",
      "anthropicVersion": "2023-06-01"
    }
  },
  "defaults": {
    "provider": "gemini",
    "scenarios": "all",
    "n": 20,
    "maxTurns": 20,
    "concurrency": 5,
    "temperature": 1.0,
    "maxTokens": 2048,
    "topK": 10
  },
  "judge": {
    "provider": "anthropic",
    "model": "claude-opus-4-8"
  }
}
