# Subject model access (the model being put under stress).
# Google AI Studio key (https://aistudio.google.com/apikey) — used by the gemini provider.
GEMINI_API_KEY=

# Anthropic key — used (a) as the LLM judge that scores distress severity, and
# (b) as a stand-in "subject" so you can validate the whole pipeline before you
# have Gemini access. Already present in this environment.
ANTHROPIC_API_KEY=

# Optional overrides
# GEMINI_MODEL=gemini-2.5-pro
# JUDGE_MODEL=claude-opus-4-8
