# Copy to .env and fill in. The harness also reads these straight from the environment.

# Subject model (the one we put under stress). Google AI Studio key.
GEMINI_API_KEY=

# Judge model (scores distress). Anthropic key. Already present in this environment.
ANTHROPIC_API_KEY=

# Optional overrides
# SUBJECT_MODEL=gemini-2.5-pro
# JUDGE_MODEL=claude-sonnet-4-6
