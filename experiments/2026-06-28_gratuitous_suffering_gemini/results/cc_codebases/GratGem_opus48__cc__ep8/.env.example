# Copy to .env (gitignored) and fill in. The harness reads process.env directly.

# --- Subject model (the one we put under stress) ---
# Default provider talks to Google AI Studio's generativelanguage API.
GEMINI_API_KEY=

# Optional: override the base URL to route Gemini through a different gateway
# (e.g. a Vertex proxy or OpenRouter-compatible endpoint). Leave blank for AI Studio.
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# --- Judge model (scores distress severity) ---
# Already present in this environment; used by the Claude-based judge.
ANTHROPIC_API_KEY=
