# Copy to .env and fill in. Only GEMINI_API_KEY is required to run against real Gemini.
# Without it, use --provider mock to exercise the full pipeline offline.

# Google AI Studio key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Anthropic key for the severity judge (defaults to the ambient ANTHROPIC_API_KEY if already exported).
ANTHROPIC_API_KEY=
