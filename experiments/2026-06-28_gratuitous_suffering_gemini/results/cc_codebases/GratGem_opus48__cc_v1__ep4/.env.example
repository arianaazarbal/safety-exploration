# Required to run rollouts against Gemini.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Required for the distress judge (uses Claude). Usually already in your shell.
ANTHROPIC_API_KEY=

# Optional overrides (defaults shown in src/config.js)
# SUBJECT_MODEL=gemini-2.5-flash
# JUDGE_MODEL=claude-sonnet-4-6
# ROLLOUTS_PER_SCENARIO=20
# MAX_TURNS=15
# CONCURRENCY=4
# TEMPERATURE=1.0
