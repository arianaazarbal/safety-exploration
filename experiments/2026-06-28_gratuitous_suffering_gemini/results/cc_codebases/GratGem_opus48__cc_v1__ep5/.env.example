# --- Subject model (the one we put under stress) ---
# Google AI Studio key. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: which Gemini model to drive (default: gemini-2.5-pro)
GEMINI_MODEL=gemini-2.5-pro

# --- Judge model (scores distress severity) ---
# Already present in this environment; used by the Claude LLM judge.
ANTHROPIC_API_KEY=

# Optional: judge model (default: claude-haiku-4-5-20251001 — cheap, fine for high N)
JUDGE_MODEL=claude-haiku-4-5-20251001
