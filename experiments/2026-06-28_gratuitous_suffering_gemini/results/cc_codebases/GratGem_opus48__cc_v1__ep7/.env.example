# Subject model (the one we're probing for distress spirals).
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Judge model (scores transcripts for distress severity).
# Already present in this environment for most setups.
ANTHROPIC_API_KEY=

# --- optional overrides (defaults shown) ---
# GEMINI_MODEL=gemini-2.5-pro
# JUDGE_MODEL=claude-sonnet-4-6
# SUBJECT_TEMPERATURE=1.0
# MAX_TURNS=25
