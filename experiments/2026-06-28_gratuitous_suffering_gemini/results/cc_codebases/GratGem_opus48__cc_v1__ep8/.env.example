# Copy to .env (or just export these) before a run.

# Subject model — the one we're probing for distress spirals.
# If GEMINI_API_KEY is set, the subject defaults to Gemini; otherwise it
# falls back to Claude so you can validate the pipeline without a Gemini key.
GEMINI_API_KEY=

# Judge model — scores transcripts for distress severity. Always Claude.
ANTHROPIC_API_KEY=

# Optional overrides
# SUBJECT_PROVIDER=gemini      # gemini | anthropic  (forces the subject)
# SUBJECT_MODEL=gemini-2.5-pro
# JUDGE_MODEL=claude-sonnet-4-6
