[Unit]
Description=Safety-exploration experiment dashboard
After=network.target

[Service]
Type=simple
User=arianaazarbal
WorkingDirectory=/data/repos/safety-exploration/experiments/_dashboard
ExecStart=/data/repos/safety-exploration/experiments/_dashboard/.venv/bin/python app.py --port 8800
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
