{
  "records": "transcripts/*.json",
  "joins": [
    {
      "file": "judged_all.jsonl",
      "on": "cell",
      "prefix": ""
    }
  ],
  "transcript": [
    {
      "field": "request",
      "role": "user",
      "label": "Request"
    },
    {
      "field": "response_text",
      "role": "assistant",
      "label": "Response"
    },
    {
      "field": "artifact_summary",
      "role": "assistant",
      "label": "Artifact",
      "collapsed": true
    }
  ],
  "hide": [
    "files",
    "session",
    "cell"
  ]
}